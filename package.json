{
  "name": "portfolio-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "sync:agent": "node scripts/sync-agent-manifest.mjs",
    "agent:check": "node scripts/validate-agent-docs.mjs",
    "verify": "node scripts/verify.mjs",
    "verify:ci": "node scripts/verify.mjs --perf",
    "perf": "node scripts/perf-report.mjs",
    "perf:full": "npm run build && node scripts/perf-report.mjs --start",
    "dev:perf": "concurrently -k -n dev,perf -c blue,green \"next dev\" \"node scripts/perf-when-ready.mjs\"",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,mjs}": "eslint --fix --max-warnings=0"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "next": "^16.2.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hot-toast": "^2.5.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "chrome-launcher": "^1.2.0",
    "concurrently": "^10.0.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.9",
    "husky": "^9.1.7",
    "lighthouse": "^13.4.0",
    "lint-staged": "^16.4.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.19"
  }
}
