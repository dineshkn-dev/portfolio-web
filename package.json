{
  "name": "portfolio-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "sync:agent": "node scripts/sync-agent-manifest.mjs",
    "agent:check": "node scripts/validate-agent-docs.mjs",
    "verify": "node scripts/verify.mjs",
    "verify:ci": "node scripts/verify.mjs --perf",
    "perf": "node scripts/perf-report.mjs",
    "perf:full": "npm run build && node scripts/perf-report.mjs --start",
    "dev:perf": "concurrently -k -n dev,perf -c blue,green \"next dev\" \"node scripts/perf-when-ready.mjs\"",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,mjs}": "eslint --fix --max-warnings=0"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@vercel/analytics": "^1.5.0",
    "@vercel/speed-insights": "^1.2.0",
    "framer-motion": "^12.4.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.23",
    "next": "^16.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hot-toast": "^2.5.2",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "chrome-launcher": "^1.2.0",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "^16.1.6",
    "husky": "^9.1.7",
    "lighthouse": "^12.8.2",
    "lint-staged": "^15.5.2",
    "postcss": "^8",
    "tailwindcss": "^3.4.1"
  }
}
